{
  "name": "mmgs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MMGS -- Modular Media Generation System, real-estate video pipeline (see AI_BIBLE/*.md)",
  "scripts": {
    "property:run": "node --env-file-if-exists=.env src/cli/run-property-engine.mjs",
