# Copy to .env and fill in. Never commit the real .env.

# Required by Property Engine (07_PROPERTY_ENGINE.md) -- Claude Haiku entity extraction.
# Get one at https://console.anthropic.com -- this is separate from any Claude subscription login.
ANTHROPIC_API_KEY=

# Required by Video/House Engine once implemented -- direct Kling API (16_PROVIDER_INTERFACE.md).
# Preferred over the connected Higgsfield MCP right now: user has ~$30 real credit on Kling
# vs. only 10 free credits on Higgsfield MCP (see .claude/agents/provider-interface.md).
KLING_API_KEY=

# Google Maps Geocoding/Static Map/Street View -- needed once Google Engine is implemented (08_GOOGLE_ENGINE.md).
GOOGLE_MAPS_API_KEY=

# ---- WF5 engine selection (WF5 §7 / Policy §3.1(4): never hardcode a vendor) ----
# Swap providers without touching engine code. Defaults are kling for both.
#   VIDEO_ENGINE = kling | higgsfield | runway
#   IMAGE_ENGINE = kling | sdxl | higgsfield
VIDEO_ENGINE=kling
IMAGE_ENGINE=kling

# Needed for WF5 step 5.7 (voice over). Not set yet -- 5.7 is blocked until it is.
ELEVENLABS_API_KEY=

# ---- Publish Engine (14_PUBLISH_ENGINE.md) ----
# Step-by-step instructions for every one of these: 21_PUBLISH_SETUP.md
# A destination with missing vars is skipped with ERR_PUB_03 -- it never fails the run.
# `npm run publish -- readiness` prints exactly which of these are still empty.

# Facebook Page feed + Facebook Reels (one token covers both).
# Page "ติดดินบินโดรน - ขายที่ดินนครนายก". Use a non-expiring PAGE token, not a user token.
LINE_CHANNEL_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# LINE OA chat bot (23_PAGE_STUDIO.md §3.6) -- webhook signature verification.
# Console: LINE Developers > your channel > Basic settings > Channel secret.
# Different value from LINE_CHANNEL_ACCESS_TOKEN above; both are required for the bot.
LINE_CHANNEL_SECRET=

# The admin's own personal LINE user id (a "U..." string, not a phone number or display
# name) -- the bot pushes here when an appointment gets booked or when it hits a question
# it has no tool to answer (23_PAGE_STUDIO.md §3.6). Get it by messaging the OA once from
# the admin's personal LINE account and reading event.source.userId off the server logs
# for that message (there is no other way to look this up -- LINE does not expose it via
# the OA Manager UI). Notifications are silently dropped (logged, not thrown) if unset.
ADMIN_LINE_USER_ID=

# ElevenLabs -- Thai TTS for WF8 (photo narration). Set this and voice.mjs switches from
# the macOS `say` command to ElevenLabs automatically, which is what makes narrated video
# work on Linux/Railway at all -- `say` does not exist there. Needs a PAID plan: the free
# tier returns 402 "Free users cannot use library voices via the API".
# Optional overrides: ELEVENLABS_VOICE_ID (default Rachel), ELEVENLABS_MODEL
# (default eleven_multilingual_v2, which speaks Thai on any voice id).
ELEVENLABS_API_KEY=

# Kling video model. Two APIs live behind one adapter and the value here picks which:
#   kling-v2-master  (default) -- the /v1/videos/image2video API on api.klingai.com
#   kling-v1-6                 -- same API; the ONLY family that accepts an end frame
#   kling-3.0-turbo            -- the newer /image-to-video API on api-singapore.klingai.com
#                                 (720p/1080p, 3-15s, plain bearer auth)
#
# WARNING: 3.0 Turbo supports a FIRST frame only. The construction sequence and the
# storyboard descent morph toward a specified end frame, so those shots must stay on a
# v1-family model -- the adapter throws rather than silently dropping the end frame.
KLING_MODEL=
# 720p or 1080p; 3.0 Turbo only. Default 1080p.
KLING_RESOLUTION=

# Instagram Reels -- reuses FACEBOOK_PAGE_ACCESS_TOKEN, plus the linked IG business id.
INSTAGRAM_BUSINESS_ID=

# TikTok Content Posting API. Until the app passes TikTok's review every post is forced
# private, so SELF_ONLY is the honest default.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# YouTube Data API v3. The refresh token is exchanged for a fresh access token on every
# upload, which is what lets the daily cron run unattended.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private

# Public https base URL serving output/. Instagram and LINE will not accept an upload --
# they fetch the file themselves -- so those two stay blocked until this exists.
PUBLIC_MEDIA_BASE_URL=

# fal.ai -- Veo 3.1 first+last frame (โหมดอัตโนมัติของ 3-WF)
# จำเป็นเฉพาะเมื่อใช้ปุ่ม "สร้างให้เลย" ที่ไม่ต้องเปิด Google Flow
# หมายเหตุ: คนละตัวกับ Google AI Plus -- subscription นั้นให้สิทธิ์ Flow (เว็บ) ไม่ใช่ API
FAL_KEY=
# ทางเลือก: FAL_RESOLUTION=720p|1080p|4k (default 1080p) · FAL_TIMEOUT_MS · WF_AUTO_ENGINE
